# Copy this file to `.env` for local runs. Never commit real API keys.

# Text-only stages: Crazyrouter -> gpt-4o-mini
CRAZYROUTER_BASE_URL=https://cn.crazyrouter.com/v1
SCAMMARK_LLM_MODEL=gpt-4o-mini
SCAMMARK_LLM_BASE_URL=https://cn.crazyrouter.com/v1
SCAMMARK_LLM_API_KEY=PASTE_YOUR_CRAZYROUTER_KEY_HERE

# Visual and multimodal stages: Alibaba Cloud Model Studio -> qwen3-vl-flash
# Use the workspace-specific OpenAI-compatible endpoint exported by Model Studio.
DASHSCOPE_API_KEY=PASTE_YOUR_DASHSCOPE_KEY_HERE
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_WORKSPACE_ID=YOUR_WORKSPACE_ID
DASHSCOPE_WORKSPACE_NAME=YOUR_WORKSPACE_NAME
SCAMMARK_VLM_MODEL=qwen3-vl-flash
SCAMMARK_VLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
SCAMMARK_VLM_API_KEY=PASTE_YOUR_DASHSCOPE_KEY_HERE

# Backward-compatible generic defaults point to the text model.
OPENAI_BASE_URL=https://cn.crazyrouter.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=PASTE_YOUR_CRAZYROUTER_KEY_HERE

# Optional request metadata.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=ScamWeb-V
SCAMMARK_INCLUDE_IMAGE=0

# Machine-local raw dataset root. Raw data is never stored in this repository.
# Linux example: /data/scamweb_dataset
# Windows example: D:/datasets/scamweb_dataset
SCAMWEB_DATASET_ROOT=/data/scamweb_dataset

# Pinned offline evaluation assets.
HF_HOME=models/huggingface
SCAMMARK_BERTSCORE_MODEL=models/huggingface/FacebookAI_xlm-roberta-large_c23d21b0620b635a76227c604d44e43a9f0ee389
